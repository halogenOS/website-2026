{
  "name": "halogenos-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "preview": "NITRO_HOST=127.0.0.1 nuxt preview",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "bun run lint --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/quicksand": "^5.3.0",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.5.2"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.2",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10"
  },
  "trustedDependencies": [
    "esbuild",
    "unrs-resolver"
  ]
}
